{
  "name": "otel-loadgen",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based load generator for the OTel demo — TypeScript/Puppeteer port of the Python/Locust loadgen",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/people.json dist/",
    "start": "node dist/index.js",
    "start:local": "FRONTEND_URL=${FRONTEND_URL:-http://localhost:8080} CONCURRENCY=${CONCURRENCY:-1} BROWSER_HEADLESS=${BROWSER_HEADLESS:-false} SYNTHETIC_REQUEST_ENABLED=${SYNTHETIC_REQUEST_ENABLED:-false} ts-node src/index.ts",
    "dev": "ts-node src/index.ts"
  },
  "dependencies": {
    "@demoability/loadgen-core": "^1.3",
    "puppeteer": "^24.29.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ts-node": "^10",
    "typescript": "^5.9"
  }
}
